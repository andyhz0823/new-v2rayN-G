+package com.v2ray.ang.xboard
+
+import okhttp3.MediaType.Companion.toMediaType
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import org.json.JSONObject
+import java.util.concurrent.TimeUnit
+
+class XboardApiClient(panelUrl: String) {
+    private val panelUrl = XboardSubscriptionParser.normalizeHttpUrl(panelUrl).trimEnd('/') + "/"
+    private val http = OkHttpClient.Builder()
+        .connectTimeout(15, TimeUnit.SECONDS)
+        .readTimeout(20, TimeUnit.SECONDS)
+        .build()
+
+    suspend fun loginAndGetSubscriptions(email: String, password: String): List<XboardSubscriptionProfile> {
+        require(email.isNotBlank() && password.isNotBlank()) { "请输入邮箱和密码" }
+        val body = JSONObject().apply {
+            put("email", email)
+            put("password", password)
+        }.toString().toRequestBody("application/json".toMediaType())
+        val login = execute(
+            Request.Builder()
+                .url(panelUrl + "api/v1/passport/auth/login")
+                .post(body)
+                .build()
+        )
+        val loginData = requireData(login, "登录失败，请检查面板地址、邮箱和密码")
+        val authData = loginData.optString("auth_data").removePrefix("Bearer ").trim()
+        if (authData.isBlank()) throw IllegalStateException("登录响应缺少鉴权信息")
+
+        val subscribe = execute(
+            Request.Builder()
+                .url(panelUrl + "api/v1/user/getSubscribe")
+                .header("Authorization", "Bearer $authData")
+                .build()
+        )
+        return XboardSubscriptionParser.parse(subscribe, panelUrl)
+    }
+
+    private suspend fun execute(request: Request): JSONObject = kotlinx.coroutines.withContext(kotlinx.coroutines.Dispatchers.IO) {
+        http.newCall(request).execute().use { response ->
+            val text = response.body?.string().orEmpty()
+            if (!response.isSuccessful) {
+                val message = runCatching { JSONObject(text).optString("message") }.getOrNull().orEmpty()
+                throw IllegalStateException(message.ifBlank { "Xboard 请求失败（HTTP ${response.code}）" })
+            }
+            JSONObject(text)
+        }
+    }
+
+    private fun requireData(envelope: JSONObject, fallback: String): JSONObject {
+        if (!envelope.optString("status").equals("success", ignoreCase = true)) {
+            throw IllegalStateException(envelope.optString("message").ifBlank { fallback })
+        }
+        return envelope.optJSONObject("data") ?: throw IllegalStateException(fallback)
+    }
+}
+
+object XboardLoginSession {
+    var authenticated: Boolean = false
+        private set
+
+    fun markAuthenticated() { authenticated = true }
+    fun clear() { authenticated = false }
+}
+
