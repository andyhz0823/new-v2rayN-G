@@ -0,0 +1,58 @@
+package com.v2ray.ang.xboard
+
+import android.content.Context
+import com.v2ray.ang.dto.entities.SubscriptionItem
+import com.v2ray.ang.handler.MmkvManager
+import com.v2ray.ang.handler.SubscriptionUpdater
+import com.v2ray.ang.helper.MessageHelper
+import com.v2ray.ang.AppConfig
+import com.v2ray.ang.dto.SubscriptionUpdateMessage
+import java.security.MessageDigest
+
+object XboardSubscriptionSync {
+    private const val MANAGED_PREFIX = "xboard:"
+
+    fun sync(context: Context, profiles: List<XboardSubscriptionProfile>): List<String> {
+        val usable = profiles.filter { it.isUsable() }
+        if (usable.isEmpty()) throw IllegalStateException("当前账号没有可用的订阅套餐（可能已到期或流量已用尽）")
+
+        val desired = usable.map { stableKey(it) }.toSet()
+        MmkvManager.decodeSubscriptions()
+            .filter { it.guid.startsWith(MANAGED_PREFIX) }
+            .filter { !desired.contains(it.guid.removePrefix(MANAGED_PREFIX)) }
+            .forEach { MmkvManager.removeSubscription(it.guid) }
+
+        val ids = mutableListOf<String>()
+        usable.forEach { profile ->
+            val key = stableKey(profile)
+            val id = MANAGED_PREFIX + key
+            val item = SubscriptionItem(
+                remarks = "${profile.name ?: "Xboard 订阅套餐"} [${if (profile.isExternal) "外部" else "内部"}]",
+                url = profile.subscribeUrl,
+                enabled = true,
+                autoUpdate = true,
+                updateInterval = 60L,
+                userAgent = "v2rayn-g/1.0"
+            )
+            MmkvManager.encodeSubscription(id, item)
+            ids += id
+        }
+        SubscriptionUpdater.sync(context, forceReschedule = true)
+        MessageHelper.sendMsg2SubscriptionService(
+            context,
+            SubscriptionUpdateMessage(AppConfig.MSG_SUB_UPDATE_START, true, ids)
+        )
+        return ids
+    }
+
+    private fun stableKey(profile: XboardSubscriptionProfile): String {
+        profile.subscriptionId?.let { return "subscription-$it" }
+        val digest = MessageDigest.getInstance("SHA-256")
+            .digest(profile.subscribeUrl.toByteArray())
+        return "url-" + digest.joinToString("") { "%02x".format(it) }.take(20)
+    }
+}
+
+
+
+
