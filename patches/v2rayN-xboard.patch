+<Window
+    x:Class="v2rayN.Desktop.Views.XboardLoginWindow"
+    xmlns="https://github.com/avaloniaui"
+    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
+    Title="v2rayN-G 登录"
+    Width="520"
+    Height="430"
+    CanResize="False"
+    ShowInTaskbar="True"
+    WindowStartupLocation="CenterScreen">
+    <Border Padding="32" Theme="{DynamicResource CardBorder}">
+        <StackPanel Spacing="12">
+            <TextBlock FontSize="26" FontWeight="Bold" Text="v2rayN-G" />
+            <TextBlock Opacity="0.72" Text="登录 Xboard 后自动同步已购买的订阅套餐" TextWrapping="Wrap" />
+            <TextBlock Margin="0,12,0,0" Text="Xboard 面板地址" />
+            <TextBox x:Name="txtPanelUrl" Watermark="https://panel.example.com" />
+            <TextBlock Text="邮箱" />
+            <TextBox x:Name="txtEmail" Watermark="user@example.com" />
+            <TextBlock Text="密码" />
+            <TextBox x:Name="txtPassword" PasswordChar="●" />
+            <TextBlock x:Name="txtStatus" MinHeight="42" Foreground="{DynamicResource SemiColorText2}" TextWrapping="Wrap" />
+            <Button x:Name="btnLogin" Height="38" HorizontalAlignment="Stretch" Content="登录并同步套餐" IsDefault="True" />
+        </StackPanel>
+    </Border>
+</Window>
