index 0000000000000000000000000000000000000000..fda77678f7a1dbbc1c430c3e3e58c48aaf21c42d
--- /dev/null
+++ b/v2rayN/v2rayN.Desktop/Xboard/XboardSubscriptionSynchronizer.cs
@@ -0,0 +1,92 @@
+using ServiceLib.Handler;
+using ServiceLib.Models.Entities;
+using ServiceLib.Manager;
+using V2rayNG.Xboard;
+
+namespace v2rayN.Desktop.Xboard;
+
+public static class XboardSubscriptionSynchronizer
+{
+    private const string ManagedPrefix = "xboard:";
+
+    public static async Task<int> SyncAsync(
+        XboardSubscribeResult result,
+        CancellationToken cancellationToken = default)
+    {
+        var usable = result.Subscriptions.Where(p => p.IsUsable).ToList();
+        if (usable.Count == 0)
+        {
+            throw new XboardApiException("当前账号没有可用的订阅套餐（可能已到期或流量已用尽）。");
+        }
+
+        var current = await AppManager.Instance.SubItems();
+        var desiredKeys = usable.Select(GetStableKey).ToHashSet(StringComparer.OrdinalIgnoreCase);
+        foreach (var stale in current.Where(item => item.Memo?.StartsWith(ManagedPrefix, StringComparison.Ordinal) == true))
+        {
+            if (!desiredKeys.Contains(item.Memo![ManagedPrefix.Length..]))
+            {
+                await ConfigHandler.DeleteSubItem(AppManager.Instance.Config, item.Id);
+            }
+        }
+
+        var sort = 1;
+        foreach (var profile in usable)
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+            var key = GetStableKey(profile);
+            var item = new SubItem
+            {
+                Id = ManagedPrefix + key,
+                Remarks = BuildRemarks(profile),
+                Url = profile.SubscribeUrl,
+                Enabled = true,
+                AutoUpdateInterval = 60,
+                Sort = sort++,
+                Memo = ManagedPrefix + key,
+                UserAgent = "v2rayn-g/1.0"
+            };
+            if (await ConfigHandler.AddSubItem(AppManager.Instance.Config, item) != 0)
+            {
+                throw new XboardApiException($"保存订阅套餐失败：{item.Remarks}");
+            }
+        }
+
+        return usable.Count;
+    }
+
+    public static Task UpdateAsync(CancellationToken cancellationToken = default)
+    {
+        return SubscriptionHandler.UpdateProcess(
+            AppManager.Instance.Config,
+            string.Empty,
+            false,
+            (success, message) =>
+            {
+                if (!success && !string.IsNullOrWhiteSpace(message))
+                {
+                    Logging.SaveLog("XboardSubscriptionUpdate", new Exception(message));
+                }
+                return Task.CompletedTask;
+            });
+    }
+
+    private static string GetStableKey(XboardSubscriptionProfile profile)
+    {
